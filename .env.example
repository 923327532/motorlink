# Copiar a ".env" (NO versionar) y reemplazar los valores. Ningún valor de este archivo es real.

# --- SQL Server ---
# Mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos (requisito de SQL Server).
MSSQL_SA_PASSWORD=CHANGE_ME_Strong#Password1
# Developer = solo desarrollo/pruebas. En producción: Standard, Enterprise, Express, etc. (según licencia).
MSSQL_PID=Developer

# --- API / JWT ---
# Clave de firma HS256, mínimo 32 caracteres aleatorios. Generar, p. ej.: openssl rand -base64 48
JWT_KEY=CHANGE_ME_generate_a_random_key_of_at_least_32_chars
JWT_ISSUER=MotorLink.API
JWT_AUDIENCE=MotorLink.Web

# Administrador inicial (opcional). Si ambos están definidos se crea al iniciar la API si no existe.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Entorno ---
# Development: Swagger disponible y cookies sin Secure sobre HTTP.  Production: HTTPS/cookies Secure.
ASPNETCORE_ENVIRONMENT=Development
SWAGGER_ENABLED=true
# Poner en true cuando exista HTTPS delante del frontend (proxy inverso con TLS).
SECURE_COOKIES=false

# --- Puertos publicados ---
WEB_PORT=5090
API_PORT=5080
# 127.0.0.1 = solo desde el host. No exponer la API directamente a Internet.
API_BIND=127.0.0.1

# --- Fotografías (Cloudinary) ---  https://cloudinary.com/console  (nunca versionar valores reales)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Suscripciones ---
# true = el propio usuario puede completar un pago SIMULADO (demo). No se cobra dinero. En producción dejar false.
BILLING_DEMO_PAYMENTS=true
# Minutos entre ejecuciones del proceso periódico (vence suscripciones/negociaciones y limpia archivos huérfanos). 0 = desactivado.
MAINTENANCE_INTERVAL_MINUTES=10

# --- Fotografías sin Cloudinary ---
# true = guarda las fotos en disco (volumen media_data). Solo desarrollo/demo; con Cloudinary configurado se ignora.
IMAGE_LOCAL_FALLBACK=false
