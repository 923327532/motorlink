{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "MotorLink.API",
    "Audience": "MotorLink.Web",
    "Key": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  },
  "Database": {
    "MigrateOnStartup": false,
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "Security": {
    "RequireHttps": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Billing": {
    "DemoPaymentsEnabled": false
  },
  "ImageStorage": {
    "LocalFallback": false,
    "Path": "App_Data/images"
  },
  "Maintenance": {
    "IntervalMinutes": 10
  }
}
