@model List<PlanInfo>
@{
    ViewData["Title"] = "Planes";
    ViewData["Description"] = "Planes mensuales de MotorLink para publicar, destacar y gestionar tus vehículos.";
    var plans = Model.OrderBy(p => p.SortOrder).ToList();
    string Cell(bool on) => on ? "Incluido" : "—";
}
<div class="page-head">
    <div class="ml-container">
        <span class="eyebrow">Planes mensuales</span>
        <h1>Elige el plan que impulsa tus publicaciones</h1>
        <p>Todos los planes permiten buscar vehículos, guardar favoritos, negociar y contactar propietarios. Los precios y límites que ves aquí son los vigentes en la plataforma.</p>
    </div>
</div>

<section class="ml-section ml-section--tight">
    <div class="ml-container">
        <div class="notice mb-4"><i data-lucide="flask-conical"></i><div><strong>Contratación de demostración.</strong> En esta versión el pago es simulado: no se solicitan tarjetas ni se cobra dinero. Los pagos reales se integrarán más adelante.</div></div>
        <div class="row g-3">
            @foreach (var p in plans)
            {
                <div class="col-md-6 col-xl"><partial name="_PlanCard" model="p" /></div>
            }
        </div>
    </div>
</section>

<section class="ml-section ml-section--white" aria-labelledby="compare-title">
    <div class="ml-container">
        <div class="section-head"><div><h2 id="compare-title">Comparativa de planes</h2><p>Lo que incluye cada plan, lado a lado.</p></div></div>
        <div class="table-wrap">
            <table class="compare-table">
                <caption class="visually-hidden">Comparativa de beneficios por plan</caption>
                <thead>
                    <tr><th scope="col">Beneficio</th>@foreach (var p in plans) { <th scope="col" class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@p.Name</th> }</tr>
                </thead>
                <tbody>
                    <tr><td>Precio mensual</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "") tabular"><strong>@(p.MonthlyPrice == 0 ? "S/ 0" : Ui.Money("PEN", p.MonthlyPrice))</strong></td> }</tr>
                    <tr><td>Publicaciones activas</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@p.MaxActiveListings</td> }</tr>
                    <tr><td>Fotografías por vehículo</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@p.MaxPhotosPerVehicle</td> }</tr>
                    <tr><td>Publicaciones destacadas</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@(p.MaxFeaturedListings == 0 ? "—" : p.MaxFeaturedListings.ToString())</td> }</tr>
                    <tr><td>Estadísticas</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@(p.HasAdvancedStats ? "Avanzadas" : "Básicas")</td> }</tr>
                    <tr><td>Perfil empresarial</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@Cell(p.HasBusinessProfile)</td> }</tr>
                    <tr><td>Exportación de reportes</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@Cell(p.CanExportReports)</td> }</tr>
                    <tr><td>Soporte prioritario</td>@foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">@Cell(p.HasPrioritySupport)</td> }</tr>
                    <tr>
                        <td>Buscar, favoritos, negociar y contactar</td>
                        @foreach (var p in plans) { <td class="@(p.Code == "PROFESSIONAL" ? "is-featured" : "")">Incluido</td> }
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="hint mt-3">Si tu plan vence, tus publicaciones que excedan el límite del plan Gratis se pausan. Nunca eliminamos tus vehículos ni fotografías.</p>
    </div>
</section>
