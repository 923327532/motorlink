<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Acceso") · MotorLink</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <meta name="robots" content="noindex" />
    <partial name="_Styles" />
</head>
<body data-auth="false">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="auth-shell">
        <main class="auth-main" id="contenido">
            <div class="auth-card">
                <div class="mb-5"><partial name="_Brand" model="false" /></div>
                @RenderBody()
            </div>
        </main>
        <aside class="auth-aside" aria-hidden="true">
            <div><partial name="_Brand" model="true" /></div>
            <div>
                <h2>Tu próximo vehículo, tu próxima oportunidad.</h2>
                <p class="mb-0">Compra, vende, alquila y negocia directamente con los propietarios.</p>
            </div>
        </aside>
    </div>
    <partial name="_Toasts" />
    <partial name="_Scripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>
