@{
    var nav = ViewData["Nav"] as string;
    var authed = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole("ADMIN");
    string Active(string key) => nav == key ? "is-active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " · MotorLink" : "MotorLink · Compra, vende y alquila vehículos")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Marketplace de vehículos nuevos y usados: compra, vende, alquila y encuentra vehículos para trabajar como taxista, repartidor o transportista.")" />
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <partial name="_Styles" />
    @RenderSection("Head", required: false)
</head>
<body data-auth="@(authed ? "true" : "false")">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <div class="ml-container">
            <partial name="_Brand" model="false" />
            <nav class="site-nav" aria-label="Principal">
                <a class="@Active("buy")" href="/vehiculos?operation=SALE">Comprar</a>
                <a class="@Active("rent")" href="/vehiculos?operation=RENT">Alquilar</a>
                <a class="@Active("work")" href="/vehiculos?operation=WORK_RENT">Vehículos para trabajar</a>
                <a class="@Active("plans")" href="/planes">Planes</a>
            </nav>
            <div class="site-actions">
                @if (authed)
                {
                    <div class="dropdown">
                        <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Menú de tu cuenta">
                            <span class="avatar" aria-hidden="true">@Ui.Initials(User.Identity?.Name)</span>
                            <span class="d-none d-xl-inline">@User.Identity?.Name</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/panel"><i data-lucide="layout-dashboard"></i>Mi panel</a></li>
                            <li><a class="dropdown-item" href="/panel/listings"><i data-lucide="megaphone"></i>Mis publicaciones</a></li>
                            <li><a class="dropdown-item" href="/panel/favorites"><i data-lucide="heart"></i>Favoritos</a></li>
                            @if (isAdmin)
                            {
                                <li><a class="dropdown-item" href="/admin"><i data-lucide="shield-check"></i>Administración</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-controller="Auth" asp-action="Logout" asp-area="" data-no-loading>
                                    <button type="submit" class="dropdown-item w-100"><i data-lucide="log-out"></i>Cerrar sesión</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-ghost" href="/ingresar">Iniciar sesión</a>
                }
                <a class="btn btn-primary" href="/panel/publish"><i data-lucide="plus"></i>Publicar vehículo</a>
            </div>
            <button class="icon-btn nav-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobile-menu" aria-controls="mobile-menu" aria-label="Abrir menú"><i data-lucide="menu"></i></button>
        </div>
    </header>

    <div class="offcanvas offcanvas-end mobile-menu" tabindex="-1" id="mobile-menu" aria-labelledby="mobile-menu-title">
        <div class="offcanvas-header">
            <h2 class="offcanvas-title h5" id="mobile-menu-title">Menú</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body">
            <a href="/vehiculos?operation=SALE">Comprar</a>
            <a href="/vehiculos?operation=RENT">Alquilar</a>
            <a href="/vehiculos?operation=WORK_RENT">Vehículos para trabajar</a>
            <a href="/planes">Planes</a>
            @if (authed)
            {
                <a href="/panel">Mi panel</a>
                @if (isAdmin) { <a href="/admin">Administración</a> }
                <form method="post" asp-controller="Auth" asp-action="Logout" asp-area="" class="mt-3" data-no-loading><button class="btn btn-light w-100" type="submit">Cerrar sesión</button></form>
            }
            else
            {
                <a href="/ingresar">Iniciar sesión</a>
                <a href="/registro">Crear cuenta</a>
            }
            <a class="btn btn-primary mt-3" href="/panel/publish">Publicar vehículo</a>
        </div>
    </div>

    <main id="contenido">@RenderBody()</main>

    <footer class="site-footer">
        <div class="ml-container">
            <div class="site-footer__grid">
                <div>
                    <partial name="_Brand" model="true" />
                    <p class="mt-3 mb-0">Compra, vende y alquila vehículos, y encuentra oportunidades para trabajar con uno.</p>
                </div>
                <div>
                    <h3>Explorar</h3>
                    <ul>
                        <li><a href="/vehiculos?operation=SALE">Comprar</a></li>
                        <li><a href="/vehiculos?operation=RENT">Alquilar</a></li>
                        <li><a href="/vehiculos?operation=WORK_RENT">Vehículos para trabajar</a></li>
                        <li><a href="/planes">Planes</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Tu cuenta</h3>
                    <ul>
                        <li><a href="/panel/publish">Publicar vehículo</a></li>
                        <li><a href="/ingresar">Iniciar sesión</a></li>
                        <li><a href="/registro">Crear cuenta</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Contacto</h3>
                    <ul>
                        <li>soporte@motorlink.example</li>
                        <li>Lima, Perú</li>
                        <li><a href="/terminos">Términos y condiciones</a></li>
                        <li><a href="/privacidad">Política de privacidad</a></li>
                    </ul>
                </div>
            </div>
            <div class="site-footer__legal">
                <span>&copy; @DateTime.Now.Year MotorLink. MotorLink conecta a las partes; no procesa pagos de compraventa ni alquiler entre usuarios.</span>
                <span>Versión de demostración</span>
            </div>
        </div>
    </footer>

    <partial name="_Toasts" />
    <partial name="_Scripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>
