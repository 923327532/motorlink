@model PagedResult<AdminVehicle>
@{ var search = ViewData["Search"] as string; }
<div class="page-title"><div><h2>Vehículos</h2><p>Todos los vehículos registrados. La placa se muestra enmascarada.</p></div></div>
<section class="ml-card">
    <form class="table-toolbar" method="get" role="search" data-no-loading>
        <input class="form-control w-auto flex-grow-1" type="search" name="search" value="@search" placeholder="Buscar por marca, modelo, propietario o placa" aria-label="Buscar vehículos" />
        <button class="btn btn-primary" type="submit"><i data-lucide="search"></i>Buscar</button>
    </form>
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("car", "No hay vehículos para mostrar", "Cuando los usuarios registren vehículos aparecerán aquí.")' />
    }
    else
    {
        <div class="table-wrap"><table class="ml-table">
            <caption class="visually-hidden">Vehículos</caption>
            <thead><tr><th>Vehículo</th><th>Propietario</th><th>Placa</th><th>Estado</th><th class="num">Km</th><th class="num">Fotos</th><th>Publicación</th><th>Registro</th></tr></thead>
            <tbody>
            @foreach (var v in Model.Items)
            {
                <tr>
                    <td><div class="fw-semibold">@v.Brand @v.Model @v.ModelYear</div><div class="small text-muted">@v.VehicleType</div></td>
                    <td>@v.OwnerEmail</td><td class="tabular">@(v.MaskedPlate ?? "—")</td><td>@Ui.Condition(v.Condition)</td>
                    <td class="num">@Ui.Number(v.Mileage)</td><td class="num">@v.Photos</td>
                    <td>@if (v.ListingStatus is { } st) { <span class="ml-badge ml-badge--@Ui.Tone(st)">@Ui.ListingStatus(st)</span> } else { <span class="ml-badge">Sin publicar</span> }</td>
                    <td class="text-muted">@Ui.Date(v.CreatedAt)</td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="table-foot"><span>@Model.TotalCount vehículo@(Model.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page, totalPages = Model.TotalPages })</div>
    }
</section>
