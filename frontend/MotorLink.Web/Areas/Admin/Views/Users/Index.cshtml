@model UsersViewModel
@{ ViewData["Title"] = "Usuarios"; var me = User.UserId(); }
<div class="page-title"><div><h2>Usuarios</h2><p>Gestiona cuentas: busca, bloquea o reactiva.</p></div></div>
<section class="ml-card">
    <form class="table-toolbar" method="get" role="search" data-no-loading>
        <div class="d-flex flex-wrap gap-2 flex-grow-1">
            <input class="form-control w-auto flex-grow-1" type="search" name="search" value="@Model.Search" placeholder="Buscar por correo o nombre" aria-label="Buscar usuarios" />
            <select class="form-select w-auto" name="active" aria-label="Estado" data-autosubmit>
                <option value="">Todos</option>
                <option value="true" selected="@(Model.Active == true)">Activos</option>
                <option value="false" selected="@(Model.Active == false)">Bloqueados</option>
            </select>
        </div>
        <button class="btn btn-primary" type="submit"><i data-lucide="search"></i>Buscar</button>
    </form>
    @if (Model.Page.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("users", "No se encontraron usuarios", "Prueba con otro término de búsqueda o quita los filtros.", "Limpiar", "/admin/users")' />
    }
    else
    {
        <div class="table-wrap"><table class="ml-table">
            <caption class="visually-hidden">Usuarios</caption>
            <thead><tr><th>Usuario</th><th>Roles</th><th>Plan</th><th class="num">Publicaciones</th><th>Registro</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var u in Model.Page.Items)
            {
                <tr>
                    <td><div class="d-flex align-items-center gap-2"><span class="avatar" aria-hidden="true">@Ui.Initials(u.FullName)</span><div><div class="fw-semibold">@u.FullName</div><div class="small text-muted">@u.Email</div></div></div></td>
                    <td>@foreach (var r in u.Roles) { <span class="ml-badge @(r == "ADMIN" ? "ml-badge--dark" : "")">@r</span> }</td>
                    <td>@(u.PlanCode ?? "—")</td>
                    <td class="num">@u.Listings</td>
                    <td class="text-muted">@Ui.Date(u.CreatedAt)</td>
                    <td><span class="ml-badge @(u.IsActive ? "ml-badge--success" : "ml-badge--danger")">@(u.IsActive ? "Activo" : "Bloqueado")</span></td>
                    <td>
                        <div class="table-actions">
                            @if (u.Id != me)
                            {
                                <form asp-action="SetStatus" method="post" data-no-loading>
                                    <input type="hidden" name="id" value="@u.Id" /><input type="hidden" name="active" value="@((!u.IsActive).ToString().ToLowerInvariant())" /><input type="hidden" name="search" value="@Model.Search" />
                                    @if (u.IsActive) { <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="@u.Email no podrá iniciar sesión y se cerrarán sus sesiones activas." data-confirm-title="Bloquear cuenta" data-confirm-ok="Bloquear" data-confirm-variant="danger">Bloquear</button> }
                                    else { <button type="submit" class="btn btn-sm btn-light">Reactivar</button> }
                                </form>
                            }
                            else { <span class="small text-muted">Tu cuenta</span> }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table></div>
        <div class="table-foot"><span>@Model.Page.TotalCount usuario@(Model.Page.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page.Page, totalPages = Model.Page.TotalPages })</div>
    }
</section>
