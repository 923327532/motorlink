@model PaymentsViewModel
@{
    string Who(Guid id) => Model.Users.TryGetValue(id, out var e) ? e : id.ToString()[..8];
    var tabs = new (bool? K, string L, string Q)[] { (null, "Todos", ""), (true, "Simulados", "?simulated=true"), (false, "Reales", "?simulated=false") };
}
<div class="page-title">
    <div><h2>Pagos</h2><p>Los pagos de demostración se identifican como simulados y nunca se mezclan con ingresos reales.</p></div>
    <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#demo-modal" @(Model.Pending.Count == 0 ? "disabled" : null)><i data-lucide="flask-conical"></i>Registrar pago de demostración</button>
</div>
<nav class="nav-tabs-ml" aria-label="Tipo de pago">@foreach (var t in tabs) { <a href="/admin/payments@t.Q" class="@(Model.Simulated == t.K ? "is-active" : "")">@t.L</a> }</nav>
<section class="ml-card">
    @if (Model.Page.Items.Count == 0) { <partial name="_EmptyState" model='new EmptyStateModel("receipt", "No hay pagos registrados", "Aquí aparecerán los pagos de las suscripciones.")' /> }
    else
    {
        <div class="table-wrap"><table class="ml-table">
            <caption class="visually-hidden">Pagos</caption>
            <thead><tr><th>Fecha</th><th>Usuario</th><th class="num">Monto</th><th>Estado</th><th>Tipo</th><th>Proveedor</th><th>Referencia</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Page.Items)
            {
                <tr><td>@Ui.DateTimeText(p.PaidAt ?? p.CreatedAt)</td><td>@Who(p.UserId)</td><td class="num">@Ui.Money(p.Currency, p.Amount)</td>
                    <td><span class="ml-badge ml-badge--@Ui.Tone(p.Status)">@Ui.PaymentStatus(p.Status)</span></td>
                    <td>@if (p.IsSimulated) { <span class="ml-badge ml-badge--demo">Simulado</span> } else { <span class="ml-badge ml-badge--success">Real</span> }</td>
                    <td>@(p.Provider ?? "—")</td><td class="small text-muted">@(p.ExternalReference ?? "—")</td></tr>
            }
            </tbody>
        </table></div>
        <div class="table-foot"><span>@Model.Page.TotalCount pago@(Model.Page.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page.Page, totalPages = Model.Page.TotalPages })</div>
    }
</section>

<div class="modal fade" id="demo-modal" tabindex="-1" aria-labelledby="demo-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" asp-action="Demo" method="post">
            <div class="modal-header"><h2 class="modal-title" id="demo-title">Registrar pago de demostración</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
            <div class="modal-body stack">
                <div class="notice notice--warning"><i data-lucide="flask-conical"></i><div>No se cobra dinero. Se crea un pago <strong>simulado</strong> y se activa la suscripción pendiente seleccionada.</div></div>
                <div><label class="form-label" for="demo-sub">Suscripción pendiente *</label>
                    <select id="demo-sub" name="subscriptionId" class="form-select" required><option value="">Selecciona</option>
                        @foreach (var s in Model.Pending) { <option value="@s.Id">@Who(s.UserId) · @s.PlanName (@Ui.Money("PEN", s.MonthlyPrice))</option> }
                    </select></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-primary">Registrar pago simulado</button></div>
        </form>
    </div>
</div>
