@{
    var nav = new SideNavModel(NavMenus.Admin);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Administración") · MotorLink Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <partial name="_Styles" />
    @RenderSection("Head", required: false)
</head>
<body data-auth="true">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="Menú de administración">
            <div class="app-sidebar__brand"><partial name="_Brand" model="true" /></div>
            <div class="app-sidebar__tag"><span class="ml-badge ml-badge--info">Administración</span></div>
            <partial name="_SideNav" model="nav" />
            <div class="app-sidebar__foot">
                <a class="side-nav" href="/panel"><span class="d-flex align-items-center gap-3 px-2 py-2 text-white-50"><i data-lucide="arrow-left"></i>Volver a mi panel</span></a>
                <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout" data-no-loading class="side-nav"><button type="submit"><i data-lucide="log-out"></i>Cerrar sesión</button></form>
            </div>
        </aside>

        <div class="offcanvas offcanvas-start app-sidebar-mobile" tabindex="-1" id="app-menu" aria-label="Menú de administración">
            <div class="offcanvas-header"><partial name="_Brand" model="true" /><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button></div>
            <div class="offcanvas-body p-0"><partial name="_SideNav" model="nav" /></div>
        </div>

        <div class="app-main">
            <header class="app-topbar">
                <button class="icon-btn d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#app-menu" aria-controls="app-menu" aria-label="Abrir menú"><i data-lucide="menu"></i></button>
                <h1 class="truncate">@(ViewData["Title"] ?? "Administración")</h1>
                <div class="spacer"></div>
                <span class="ml-badge ml-badge--dark d-none d-sm-inline-flex">ADMIN</span>
                <span class="avatar" aria-hidden="true">@Ui.Initials(User.Identity?.Name)</span>
            </header>
            <main class="app-content" id="contenido">@RenderBody()</main>
        </div>
    </div>
    <partial name="_Toasts" />
    <partial name="_Scripts" />
    @RenderSection("Scripts", required: false)
</body>
</html>
