@model PagedResult<AdminBusiness>
@{ var search = ViewData["Search"] as string; }
<div class="page-title"><div><h2>Empresas</h2><p>Perfiles empresariales registrados. El RUC y la verificación son datos declarados.</p></div></div>
<section class="ml-card">
    <form class="table-toolbar" method="get" role="search" data-no-loading>
        <input class="form-control w-auto flex-grow-1" type="search" name="search" value="@search" placeholder="Buscar por nombre comercial, RUC o correo" aria-label="Buscar empresas" />
        <button class="btn btn-primary" type="submit"><i data-lucide="search"></i>Buscar</button>
    </form>
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("building-2", "No hay empresas registradas", "Aparecerán aquí las cuentas que se registren como empresariales.")' />
    }
    else
    {
        <div class="table-wrap"><table class="ml-table">
            <caption class="visually-hidden">Empresas</caption>
            <thead><tr><th>Nombre comercial</th><th>RUC</th><th>Responsable</th><th class="num">Publicaciones activas</th><th>Verificación</th><th>Registro</th></tr></thead>
            <tbody>
            @foreach (var b in Model.Items)
            {
                <tr><td class="fw-semibold">@b.BusinessName</td><td class="tabular">@(b.Ruc ?? "—")</td><td>@b.OwnerEmail</td><td class="num">@b.ActiveListings</td>
                    <td>@if (b.IsVerified) { <span class="ml-badge ml-badge--success">Verificada</span> } else { <span class="ml-badge">Sin verificar</span> }</td><td class="text-muted">@Ui.Date(b.CreatedAt)</td></tr>
            }
            </tbody>
        </table></div>
        <div class="table-foot"><span>@Model.TotalCount empresa@(Model.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page, totalPages = Model.TotalPages })</div>
    }
</section>
