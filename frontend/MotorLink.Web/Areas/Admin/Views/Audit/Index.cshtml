@model PagedResult<AuditLogInfo>
@{ var action = ViewData["Action"] as string; }
<div class="page-title"><div><h2>Auditoría</h2><p>Registro de acciones administrativas y de cambios relevantes. Se muestra la dirección IP desde la que se realizó cada acción.</p></div></div>
<section class="ml-card">
    <form class="table-toolbar" method="get" role="search" data-no-loading>
        <div class="d-flex flex-wrap gap-2 flex-grow-1">
            <input class="form-control w-auto flex-grow-1" type="search" name="action" value="@action" placeholder="Filtrar por acción (p. ej. user., listing., plan., catalog.)" aria-label="Filtrar por acción" />
        </div>
        <button class="btn btn-primary" type="submit"><i data-lucide="search"></i>Filtrar</button>
    </form>
    @if (Model.Items.Count == 0) { <partial name="_EmptyState" model='new EmptyStateModel("scroll-text", "Sin registros de auditoría", "Las acciones administrativas aparecerán aquí.")' /> }
    else
    {
        <div class="table-wrap"><table class="ml-table">
            <caption class="visually-hidden">Registros de auditoría</caption>
            <thead><tr><th>Fecha</th><th>Acción</th><th>Entidad</th><th>Detalle</th><th>Usuario</th><th>IP</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Items)
            {
                <tr><td class="nowrap">@Ui.DateTimeText(a.CreatedAt)</td><td><span class="ml-badge">@a.Action</span></td><td>@a.EntityName <span class="small text-muted">@(a.EntityId?.Length > 8 ? a.EntityId[..8] : a.EntityId)</span></td>
                    <td class="small text-muted">@a.Details</td><td class="small tabular">@(a.UserId?.ToString()[..8] ?? "sistema")</td><td class="small tabular">@(a.IpAddress ?? "—")</td></tr>
            }
            </tbody>
        </table></div>
        <div class="table-foot"><span>@Model.TotalCount registro@(Model.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page, totalPages = Model.TotalPages })</div>
    }
</section>
