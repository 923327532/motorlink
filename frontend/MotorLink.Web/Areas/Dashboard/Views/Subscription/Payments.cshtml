@model PagedResult<PaymentInfo>
<div class="page-title">
    <div><h2>Historial de pagos</h2><p>Los pagos de esta versión son de demostración y no representan dinero real.</p></div>
    <a class="btn btn-light" href="/panel/subscription">Volver a mi suscripción</a>
</div>
<section class="ml-card">
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("receipt", "Aún no tienes pagos", "Cuando contrates un plan de pago verás aquí su registro.", "Ver planes", "/planes")' />
    }
    else
    {
        <div class="table-wrap">
            <table class="ml-table">
                <caption class="visually-hidden">Pagos registrados</caption>
                <thead><tr><th>Fecha</th><th>Concepto</th><th class="num">Monto</th><th>Estado</th><th>Tipo</th><th>Referencia</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td>@Ui.DateTimeText(p.PaidAt ?? p.CreatedAt)</td>
                        <td>Suscripción mensual</td>
                        <td class="num">@Ui.Money(p.Currency, p.Amount)</td>
                        <td><span class="ml-badge ml-badge--@Ui.Tone(p.Status)">@Ui.PaymentStatus(p.Status)</span></td>
                        <td>@if (p.IsSimulated) { <span class="ml-badge ml-badge--demo">Simulado</span> } else { <span class="ml-badge">Real</span> }</td>
                        <td class="text-muted small">@(p.ExternalReference ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="table-foot"><span>@Model.TotalCount registro@(Model.TotalCount == 1 ? "" : "s")</span>@await Component.InvokeAsync("Pagination", new { page = Model.Page, totalPages = Model.TotalPages })</div>
    }
</section>
