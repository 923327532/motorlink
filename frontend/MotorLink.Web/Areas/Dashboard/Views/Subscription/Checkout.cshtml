@model CheckoutViewModel
@{ var p = Model.Plan; }
<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <nav class="breadcrumb-ml" aria-label="Ruta"><a href="/panel/subscription">Mi suscripción</a><span>/</span><span aria-current="page">Confirmar plan</span></nav>
        <section class="ml-card">
            <div class="ml-card__head"><h3>Confirmar plan @p.Name</h3><span class="ml-badge ml-badge--demo">Demostración</span></div>
            <div class="ml-card__body stack">
                <div class="notice notice--warning"><i data-lucide="flask-conical"></i><div><strong>Pago simulado.</strong> No se solicitan datos de tarjeta ni se realiza ningún cobro. Al confirmar, tu plan se activa por un mes y el pago queda registrado como «Simulado».</div></div>
                <dl class="kv">
                    <dt>Plan</dt><dd>@p.Name</dd>
                    <dt>Precio</dt><dd>@Ui.Money("PEN", p.MonthlyPrice) al mes</dd>
                    <dt>Publicaciones activas</dt><dd>@p.MaxActiveListings</dd>
                    <dt>Fotografías por vehículo</dt><dd>@p.MaxPhotosPerVehicle</dd>
                    <dt>Destacadas</dt><dd>@p.MaxFeaturedListings</dd>
                    <dt>Estadísticas</dt><dd>@(p.HasAdvancedStats ? "Avanzadas" : "Básicas")</dd>
                    <dt>Perfil empresarial</dt><dd>@(p.HasBusinessProfile ? "Incluido" : "No incluido")</dd>
                    <dt>Exportación de reportes</dt><dd>@(p.CanExportReports ? "Incluida" : "No incluida")</dd>
                </dl>
                <hr class="divider my-2" />
                <div class="d-flex justify-content-between align-items-baseline"><span class="fw-semibold">Total a pagar hoy</span><span class="price">@Ui.Money("PEN", p.MonthlyPrice)</span></div>
                <form asp-action="Pay" asp-route-id="@Model.Subscription.Id" method="post">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Confirmar suscripción de demostración</button>
                </form>
                <form asp-action="Cancel" asp-route-id="@Model.Subscription.Id" method="post" data-no-loading><button type="submit" class="btn btn-light w-100">Cancelar solicitud</button></form>
            </div>
        </section>
    </div>
</div>
