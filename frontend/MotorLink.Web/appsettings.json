{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "http://localhost:5080/"
  },
  "Sessions": {
    "Path": "data/sessions"
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "Security": {
    "RequireHttps": false,
    "SecureCookies": false
  }
}
